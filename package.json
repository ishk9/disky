{
  "name": "@ishk9/disky",
  "version": "1.0.2",
  "description": "CLI that surfaces disk hogs — node_modules, .next, dist, Docker images, build caches — with one-command cleanup",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "disky": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "node -e \"import('node:fs').then((fs) => fs.chmodSync('dist/index.js', 0o755))\"",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "disk",
    "cleanup",
    "cli",
    "dev-tools",
    "node_modules",
    "cache"
  ],
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "ink": "^4.4.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.28",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.4"
  }
}
